<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WebSecure Report — {{ target }}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', Arial, sans-serif; color: #1a1a2e; background: #f8f9fa; font-size: 13px; }

    /* Cover Page */
    .cover {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      color: #fff;
      padding: 70px 60px;
      min-height: 280px;
      page-break-after: always;
    }
    .cover h1 { font-size: 2.4em; color: #e94560; margin-bottom: 12px; letter-spacing: -0.5px; }
    .cover .meta { opacity: 0.85; margin-top: 20px; line-height: 1.8; }
    .cover .meta span { display: block; }
    .risk-badge {
      display: inline-block;
      margin-top: 24px;
      padding: 10px 28px;
      border-radius: 24px;
      font-weight: bold;
      font-size: 1.2em;
      background: {{ overall_risk_color }};
      color: #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .confidential {
      margin-top: 30px;
      font-size: 0.8em;
      opacity: 0.6;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    /* Sections */
    .section { padding: 36px 48px; background: #fff; margin: 0 0 20px; border-radius: 8px; }
    h2 {
      font-size: 1.4em;
      color: #0f3460;
      border-bottom: 3px solid #e94560;
      padding-bottom: 8px;
      margin-bottom: 20px;
    }
    h3 { font-size: 1.1em; color: #16213e; margin-bottom: 10px; }

    /* Severity grid */
    .stat-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; margin-bottom: 24px; }
    .stat-card {
      padding: 20px;
      border-radius: 10px;
      text-align: center;
      color: #fff;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
    .stat-card .num { font-size: 2.4em; font-weight: 700; }
    .stat-card .lbl { font-size: 0.8em; opacity: 0.9; margin-top: 4px; text-transform: uppercase; letter-spacing: 1px; }

    /* Findings */
    .finding {
      border-left: 5px solid;
      padding: 16px 20px;
      margin-bottom: 14px;
      background: #fafafa;
      border-radius: 0 8px 8px 0;
      page-break-inside: avoid;
    }
    .finding-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .finding-title { font-size: 1.05em; font-weight: 600; }
    .sev-badge { padding: 3px 12px; border-radius: 12px; color: #fff; font-size: 0.82em; font-weight: 600; }
    .finding-body { color: #444; line-height: 1.65; }
    .finding-body p { margin: 4px 0; }
    code { background: #eef0f4; padding: 1px 5px; border-radius: 3px; font-size: 0.9em; font-family: monospace; }
    .remediation { margin-top: 10px; padding: 10px 14px; background: #f0f8ff; border-left: 3px solid #17a2b8; border-radius: 4px; font-size: 0.9em; color: #2c5f7a; }

    /* Tables */
    table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.9em; }
    th { background: #16213e; color: #fff; padding: 9px 12px; text-align: left; }
    td { padding: 8px 12px; border-bottom: 1px solid #e8eaf0; }
    tr:nth-child(even) td { background: #f4f5f8; }
    tr:hover td { background: #e8edf5; }

    /* WAF / TLS info */
    .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 16px; }
    .info-card { padding: 14px 18px; background: #f4f5f8; border-radius: 8px; }
    .info-card .label { font-size: 0.78em; text-transform: uppercase; color: #888; letter-spacing: 1px; margin-bottom: 4px; }
    .info-card .value { font-size: 1.05em; font-weight: 600; color: #16213e; }

    /* Footer */
    footer { padding: 20px 48px; text-align: center; color: #aaa; font-size: 0.78em; }

    /* Print */
    @media print {
      body { background: #fff; }
      .cover { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .stat-card { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .section { box-shadow: none; }
    }
  </style>
</head>
<body>

<!-- ========== COVER ========== -->
<div class="cover">
  <h1>WebSecure Penetration Test Report</h1>
  <div class="meta">
    <span><strong>Target:</strong> {{ target }}</span>
    <span><strong>Scan Date:</strong> {{ scan_date }}</span>
    <span><strong>Tool:</strong> {{ tool_version }} &nbsp;|&nbsp; Profile: {{ scan_profile }}</span>
  </div>
  <div class="risk-badge">Overall Risk: {{ overall_risk }}</div>
  <div class="confidential">Confidential — For Authorized Personnel Only</div>
</div>

<!-- ========== EXECUTIVE SUMMARY ========== -->
<div class="section">
  <h2>Executive Summary</h2>

  <div class="stat-grid">
    <div class="stat-card" style="background:#dc3545">
      <div class="num">{{ severity_counts.Critical }}</div><div class="lbl">Critical</div>
    </div>
    <div class="stat-card" style="background:#fd7e14">
      <div class="num">{{ severity_counts.High }}</div><div class="lbl">High</div>
    </div>
    <div class="stat-card" style="background:#ffc107;color:#333">
      <div class="num">{{ severity_counts.Medium }}</div><div class="lbl">Medium</div>
    </div>
    <div class="stat-card" style="background:#17a2b8">
      <div class="num">{{ severity_counts.Low }}</div><div class="lbl">Low</div>
    </div>
    <div class="stat-card" style="background:#6c757d">
      <div class="num">{{ severity_counts.Info }}</div><div class="lbl">Info</div>
    </div>
  </div>

  <div class="info-grid">
    <div class="info-card">
      <div class="label">Total Findings</div>
      <div class="value">{{ total_findings }}</div>
    </div>
    <div class="info-card">
      <div class="label">WAF Detected</div>
      <div class="value">{{ waf_vendor }} {% if waf_confidence != '0%' %}({{ waf_confidence }}){% endif %}</div>
    </div>
    {% if tls_data %}
    <div class="info-card">
      <div class="label">TLS Version</div>
      <div class="value">{{ tls_data.get('tls_version', 'N/A') }}</div>
    </div>
    {% endif %}
    <div class="info-card">
      <div class="label">Open Ports Found</div>
      <div class="value">{{ open_ports | length }}</div>
    </div>
  </div>
</div>

<!-- ========== FINDINGS ========== -->
<div class="section">
  <h2>Vulnerability Findings</h2>

  {% if findings %}
    {% for f in findings %}
    {% set sev = f.get('severity') or f.get('cvss_severity') or 'Info' %}
    {% set color = severity_color(sev) %}
    <div class="finding" style="border-color: {{ color }};">
      <div class="finding-header">
        <span class="finding-title">{{ f.get('type', 'Unknown') }}</span>
        <span class="sev-badge" style="background:{{ color }}">
          {{ sev }}{% if f.get('cvss_score') %} &bull; CVSS {{ f.get('cvss_score') }}{% endif %}
        </span>
      </div>
      <div class="finding-body">
        <p><strong>URL:</strong> <code>{{ f.get('url', '') }}</code></p>
        {% if f.get('parameter') %}<p><strong>Parameter:</strong> <code>{{ f.get('parameter') }}</code></p>{% endif %}
        {% if f.get('payload') %}<p><strong>Payload:</strong> <code>{{ f.get('payload') | truncate(120) }}</code></p>{% endif %}
        {% if f.get('evidence') %}<p><strong>Evidence:</strong> {{ f.get('evidence') | string | truncate(250) }}</p>{% endif %}
        {% if f.get('cvss_vector') %}<p><strong>CVSS Vector:</strong> <code>{{ f.get('cvss_vector') }}</code></p>{% endif %}
        {% if f.get('verified') %}<p><strong>Verified:</strong> Yes ({{ f.get('verification_method', 'response analysis') }})</p>{% endif %}
        {% if f.get('remediation') %}
        <div class="remediation"><strong>Remediation:</strong> {{ f.get('remediation') }}</div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  {% else %}
    <p style="color:#888;font-style:italic">No vulnerability findings recorded.</p>
  {% endif %}
</div>

<!-- ========== OPEN PORTS ========== -->
{% if open_ports %}
<div class="section">
  <h2>Open Ports &amp; Services</h2>
  <table>
    <tr><th>Port</th><th>Protocol</th><th>Service</th><th>Product / Version</th></tr>
    {% for p in open_ports[:30] %}
    <tr>
      <td>{{ p.get('port') }}</td>
      <td>{{ p.get('proto', 'tcp') }}</td>
      <td>{{ p.get('service', '') }}</td>
      <td>{{ p.get('product', '') }} {{ p.get('version', '') }}</td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

<!-- ========== JS ANALYSIS ========== -->
{% if js_info and js_info.get('secrets') %}
<div class="section">
  <h2>JavaScript Analysis</h2>
  <p><strong>Secrets Exposed:</strong> {{ js_info.get('secrets') | length }}</p>
  {% if js_info.get('endpoints') %}
  <p><strong>Discovered API Endpoints:</strong> {{ js_info.get('endpoints') | length }}</p>
  {% endif %}
</div>
{% endif %}

<!-- ========== AUTH MATRIX ========== -->
{% if auth_matrix and auth_matrix.get('matrix') %}
<div class="section">
  <h2>Authorization Matrix</h2>
  {{ auth_matrix.get('html_table', '') | safe }}
</div>
{% endif %}

<!-- ========== DISCOVERED FILES ========== -->
{% if discovered_files %}
<div class="section">
  <h2>Discovered Files / Paths</h2>
  <table>
    <tr><th>URL</th><th>Status</th></tr>
    {% for f in discovered_files[:50] %}
    <tr>
      <td><code>{{ f.get('url', f) }}</code></td>
      <td>{{ f.get('status', '') }}</td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

<!-- ========== FOOTER ========== -->
<footer>
  Generated by {{ tool_version }} on {{ scan_date }}. This report is confidential and intended solely for authorized personnel.
</footer>

</body>
</html>
